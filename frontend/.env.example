# Mongez dashboard (React) — environment variables
#
# Copy to `.env` and adjust. Only VITE_API_URL is actually read by the app.

# Base URL of the Django REST API (backend/). Used by axios in src/services/api.js.
# In dev, Vite proxies /media (and /api) to http://localhost:8000, so this can
# be left as the default. Production (Railway) value:
# VITE_API_URL=https://mongez-api-production-1a85.up.railway.app/api
VITE_API_URL=http://localhost:8000/api
